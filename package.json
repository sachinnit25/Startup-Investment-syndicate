{
  "name": "startup-investment-syndicate",
  "version": "1.0.0",
  "description": "A privacy-preserving startup investment syndicate on the Midnight network",
  "main": "index.js",
  "scripts": {
    "compile": "compact compile contracts/counter.compact --output managed/",
    "test": "jest --testPathPattern=tests/",
    "deploy": "NODE_OPTIONS=\"--max-old-space-size=12288\" midnight-js deploy --network preview",
    "network": "midnight-js network"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zkp",
    "investment",
    "syndicate",
    "privacy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.14.0",
    "@midnight-ntwrk/midnight-js-contracts": "^0.14.0",
    "@midnight-ntwrk/midnight-js-types": "^0.14.0",
    "@midnight-ntwrk/midnight-js-network-id": "^0.14.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-testing": "^0.14.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
